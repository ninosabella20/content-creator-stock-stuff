# Copy to .env for LOCAL runs only (never commit .env). In GitHub these come from
# repository Secrets (Settings > Secrets and variables > Actions).
# Placeholder values only.

# --- secrets (GitHub: Secrets) ---
GEMINI_API_KEY=your-podcast-project-gemini-key
YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-client-secret
YOUTUBE_REFRESH_TOKEN=your-refresh-token

# --- optional settings (GitHub: Variables). Defaults live in config/settings.yaml ---
GEMINI_MODEL=                # empty = auto-pick newest free flash model
MAX_AI_CALLS=6               # hard cap on Gemini text calls per run
TTS_PROVIDER=gemini          # gemini | piper
NARRATOR_VOICE=Charon        # Gemini prebuilt voice
PIPER_VOICE=en-us-libritts-high
SPEAKING_RATE=1.0
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
OUTPUT_DIR=output
PUBLISH_YOUTUBE=false
YOUTUBE_PRIVACY=private      # private | unlisted (public also needs PUBLISH_PUBLICLY=true)
PUBLISH_SPOTIFY=false
PUBLISH_PUBLICLY=false
ALLOW_STALE=false
